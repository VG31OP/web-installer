<div class="crt-scanlines"></div>

<header class="app-header">
  <div class="logo-container">
    <div class="logo-glitch-wrapper">
      <span class="logo-text glitch-text" data-text="VG WEBSITE DOWNLOADER">VG WEBSITE DOWNLOADER</span>
    </div>
  </div>
  <div class="header-actions">
    <a class="github-button" href="https://github.com/VG31OP/web-installer" data-icon="octicon-star" data-size="large" data-show-count="true" aria-label="Star VG31OP/web-installer on GitHub">Star</a>
  </div>
</header>

<header class="loader-header">
  <div aria-busy="true" id="progress" hidden aria-label="Loading, please wait." role="progressbar"></div>
</header>

<main role="main" class="app-container">
  <div class="dashboard-grid">
    <!-- Left Column: Controls & Telemetry -->
    <div class="dashboard-col left-col">
      <!-- Control Deck Card -->
      <section class="cyber-card control-deck">
        <div class="cyber-corner-tr"></div>
        <div class="cyber-corner-bl"></div>
        <div class="card-tag">SYSTEM CTRL //</div>
        
        <div class="globe-container">
          <svg viewBox="0 0 24 24" width="80" height="80" class="neon-globe-svg">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="0.8" fill="none" class="circle-globe" />
            <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" stroke="currentColor" stroke-width="0.8" fill="none" class="path-globe" />
            <path d="M12 2v20" stroke="currentColor" stroke-width="0.8" fill="none" />
          </svg>
        </div>
        
        <h1 class="console-title">VG WEBSITE DOWNLOADER</h1>
        <p class="console-subtitle">Take any website offline. Crawl links, strip assets, extract archive.</p>
        
        <div class="cyber-arrow-indicator">
          <span class="arrow-text">INPUT TARGET URL</span>
          <svg class="giant-cyber-arrow" viewBox="0 0 24 24" width="48" height="48">
            <path fill="currentColor" d="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z"/>
          </svg>
        </div>

        <div class="form-container">
          <form class="download-form" id="downloadForm">
            <div class="cyber-input-group">
              <span class="input-prefix">&gt;_ URL:</span>
              <input type="text" class="url-input" id="website" placeholder="https://example.com" aria-label="Website URL" />
              <button class="download-btn" id="download" type="button">
                <span class="btn-text">ENGAGE WGET</span>
              </button>
            </div>
          </form>
        </div>
      </section>

      <!-- Telemetry Deck -->
      <section class="cyber-card telemetry-deck">
        <div class="cyber-corner-tr"></div>
        <div class="cyber-corner-bl"></div>
        <div class="card-tag">SYSTEM TELEMETRY //</div>
        
        <div class="telemetry-grid">
          <div class="tel-box">
            <span class="tel-label">CORE STATE</span>
            <span class="tel-val neon-green">READY</span>
          </div>
          <div class="tel-box">
            <span class="tel-label">QUOTA</span>
            <span class="tel-val text-cyan">100MB</span>
          </div>
          <div class="tel-box">
            <span class="tel-label">ENGINE</span>
            <span class="tel-val text-pink">WGET 1.21</span>
          </div>
          <div class="tel-box">
            <span class="tel-label">SOCKETS</span>
            <span class="tel-val text-indigo">ACTIVE</span>
          </div>
        </div>
      </section>
    </div>

    <!-- Right Column: Live Logs & Extract Button -->
    <div class="dashboard-col right-col">
      <!-- Logger Deck -->
      <section class="cyber-card logger-deck">
        <div class="cyber-corner-tr"></div>
        <div class="cyber-corner-bl"></div>
        <div class="card-tag">LIVE STREAMS //</div>
        
        <div class="terminal-status-bar">
          <div class="terminal-dots">
            <span class="terminal-dot red"></span>
            <span class="terminal-dot yellow"></span>
            <span class="terminal-dot green"></span>
          </div>
          <div class="status-counter-inline">
            <h5 hidden id="nFilesP" class="status-counter">
              FILES: <span id="nFiles">0</span>
            </h5>
          </div>
        </div>
        
        <div class="terminal-window">
          <div class="terminal-inner">
            <p class="log" id="log">CONSOLE READY. COMMAND WGET SYSTEM ONLINE.</p>
          </div>
        </div>

        <button style="display: none" class="btn btn-success download-zip-btn">
          <svg viewBox="0 0 24 24" width="20" height="20" class="zip-icon">
            <path fill="currentColor" d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM17 13l-5 5-5-5h3V9h4v4h3z"/>
          </svg>
          <span>EXTRACT ARCHIVE ZIP</span>
        </button>
      </section>

      <!-- Identity Card -->
      <section class="cyber-card identity-badge">
        <div class="cyber-corner-tr"></div>
        <div class="cyber-corner-bl"></div>
        <div class="card-tag">OPERATOR BADGE //</div>
        
        <div class="id-badge-body">
          <div class="badge-barcode">
            <span class="barcode-line"></span>
            <span class="barcode-line thin"></span>
            <span class="barcode-line thick"></span>
            <span class="barcode-line"></span>
            <span class="barcode-line thick"></span>
            <span class="barcode-line thin"></span>
            <span class="barcode-line"></span>
            <span class="barcode-line thick"></span>
          </div>
          <div class="badge-info">
            <h2 class="dev-name">VRAJ SHIROYA</h2>
            <p class="dev-handle">SYSTEM OWNER / @VG31OP</p>
            <div class="dev-links">
              <a href="https://vraj.shiroya.in" target="_blank" rel="noopener" class="dev-link-btn">&gt;_ VRAJ.SHIROYA.IN</a>
            </div>
          </div>
          <div class="badge-seal">
            <span class="seal-inner">2026 // OK</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</main>
